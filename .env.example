# Copy this file to .env and adjust. .env is git-ignored - never commit real credentials.

# PostgreSQL 16 with pgvector (docker compose maps it to port 5433 to avoid clashing with a local install)
DATABASE_URL=postgres://hisaab:hisaab_dev_pw@localhost:5433/hisaab

# MongoDB (optional - the app still works without it, logging/analytics are skipped)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=hisaab

# Secret used to sign login sessions (JWT). Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# Local embedding model (downloads ~120 MB once). Set EMBEDDINGS_DISABLED=1 to use text + fuzzy search only.
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DISABLED=0

# Credentials for the docker compose database (only used by docker-compose.yml)
POSTGRES_USER=hisaab
POSTGRES_PASSWORD=hisaab_dev_pw
POSTGRES_DB=hisaab
